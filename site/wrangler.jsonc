// Cloudflare Workers Builds deploys the built site with `npx wrangler deploy`
// (root directory site/, build command `npm ci && npm run build`). The name must
// match the Worker's name in the Cloudflare dashboard.
{
  "name": "shapelogic",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
