---
// The landing page of shapelogic.xyz, kept as the original static page
// (shapelogic.xyz repository); the user guide under /docs/ is Starlight.
import '../styles/landing.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ShapeLogic</title>
    <meta
      name="description"
      content="ShapeLogic is an open source puzzle solver, a from-scratch successor to BurrTools written with AI."
    />
    <link rel="icon" href="/assets/puzzle_icon.jpg" />
  </head>
  <body>
    <header class="banner">
      <img src="/assets/banner.png" alt="ShapeLogic" width="2000" height="666" />
    </header>

    <main>
      <p class="status">Coming soon</p>
      <h1>A fast-moving, open source puzzle solver.</h1>
      <p class="lead">
        ShapeLogic is a small open source tool for designing and solving interlocking and packing
        puzzles. It started as a fork of
        <a href="https://burrtools.sourceforge.net/">BurrTools</a>, the puzzle software created by
        Andreas Röver, and has since been rewritten from the ground up.
      </p>

      <div class="links">
        <a href="/docs/getting-started/">Getting Started <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg></a>
        <a href="https://github.com/shapelogicxyz/shapelogic/releases/latest">Download <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg></a>
        <a href="https://github.com/shapelogicxyz/shapelogic">GitHub <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="m15 3 6 0 0 6"/><path d="M10 14 21 3"/></svg></a>
        <a href="/demo/">Demo <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"/></svg></a>
      </div>

      <section class="cards">
        <div class="card">
          <h2>Built by AI</h2>
          <p>The new version was written almost entirely by Claude AI (Opus 5.5 and Fable 5.1).</p>
        </div>
        <div class="card">
          <h2>A new frontend</h2>
          <p>
            The interface is built on a web framework inspired by the amazing work of
            <a href="https://github.com/grssam">Girish Sharma</a>.
          </p>
        </div>
        <div class="card">
          <h2>Rapidly evolving</h2>
          <p>
            The goal is a BurrTools-like tool that is developed quickly and gains new features and
            modes often.
          </p>
        </div>
      </section>

    </main>

    <footer>
      <img src="/assets/puzzle_icon.jpg" alt="" width="40" height="40" />
      <p>ShapeLogic is free open-source software.</p>
    </footer>
  </body>
</html>
