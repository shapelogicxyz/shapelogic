# The checks `just check` runs (clang-tidy), every finding an error.
#
# Left out, and why:
#   bugprone-narrowing-conversions  the build has -Wconversion
#       -Wsign-conversion -Werror for the project's own code; what is left
#       is the ported sphere mesher's float arithmetic, which is kept as
#       the original's so that the meshes stay the same
#   bugprone-signed-bitwise  the ported code masks and shifts ints that
#       are never negative (cell states, bit sets, transformation numbers)
#   bugprone-implicit-widening-of-multiplication-result,
#   bugprone-misplaced-widening-cast  a shape's cells are counted in
#       unsigned int throughout (Voxel::getXYZ), as the file format holds
#       them: x * y * z is formed in that type and then indexes a vector
#   bugprone-branch-clone  conditions with one outcome are kept apart
#       where each has its own reason, said in a comment
#   bugprone-macro-parentheses  it finds the Manifold library's own
#       -DMANIFOLD_PAR=-1 on every compile line, which no comment in a
#       source can answer, and SLE_TRY's `decl`, which is a declaration
#   bugprone-throwing-static-initialization  the statics are constinit
#       tables and arrays of numbers (sqrt of constants): nothing throws
#   clang-analyzer-optin.core.EnumCastOutOfRange  fires inside Catch2's
#       own headers (flag enums or-ed together)
#   clang-analyzer-optin.performance.Padding  struct layout is not tuned
#   bugprone-easily-swappable-parameters, performance-enum-size  style
# tests/unit/.clang-tidy leaves out a few more for the tests.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-macro-parentheses,
  -bugprone-misplaced-widening-cast,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-throwing-static-initialization,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-optin.performance.Padding,
  concurrency-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-member-init,
  misc-redundant-expression,
  misc-static-assert,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-enum-size,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-make-member-function-const,
  readability-redundant-smartptr-get

HeaderFilterRegex: '(core|engine|cli|tests/unit)/.*'
WarningsAsErrors: '*'
...
