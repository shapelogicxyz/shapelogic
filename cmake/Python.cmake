# Decides SL_PYTHON_MODULE from SL_PYTHON (see the top-level CMakeLists).
# The module links the static core into a shared library, so everything is
# built position independent when it is on.
set(SL_PYTHON_MODULE OFF)
if(SL_PYTHON STREQUAL "ON")
  find_package(Python 3.10 REQUIRED COMPONENTS Interpreter Development.Module)
  set(SL_PYTHON_MODULE ON)
elseif(SL_PYTHON STREQUAL "AUTO")
  if(NOT SL_SANITIZE STREQUAL "")
    message(STATUS "Python module: off in a sanitizer build (SL_PYTHON=AUTO)")
  elseif(CMAKE_CROSSCOMPILING OR CMAKE_OSX_ARCHITECTURES)
    message(STATUS "Python module: off in a build for another architecture (SL_PYTHON=AUTO)")
  else()
    find_package(Python 3.10 COMPONENTS Interpreter Development.Module)
    if(Python_FOUND)
      set(SL_PYTHON_MODULE ON)
    else()
      message(STATUS "Python module: off, Python's headers not found (SL_PYTHON=AUTO)")
    endif()
  endif()
elseif(NOT SL_PYTHON STREQUAL "OFF")
  message(FATAL_ERROR "SL_PYTHON must be ON, OFF or AUTO, not '${SL_PYTHON}'")
endif()
if(SL_PYTHON_MODULE)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()
