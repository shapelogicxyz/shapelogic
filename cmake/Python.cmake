# Decides BT_PYTHON_MODULE from BT_PYTHON (see the top-level CMakeLists).
# The module links the static core into a shared library, so everything is
# built position independent when it is on.
set(BT_PYTHON_MODULE OFF)
if(BT_PYTHON STREQUAL "ON")
  find_package(Python 3.10 REQUIRED COMPONENTS Interpreter Development.Module)
  set(BT_PYTHON_MODULE ON)
elseif(BT_PYTHON STREQUAL "AUTO")
  if(NOT BT_SANITIZE STREQUAL "")
    message(STATUS "Python module: off in a sanitizer build (BT_PYTHON=AUTO)")
  elseif(CMAKE_CROSSCOMPILING OR CMAKE_OSX_ARCHITECTURES)
    message(STATUS "Python module: off in a build for another architecture (BT_PYTHON=AUTO)")
  else()
    find_package(Python 3.10 COMPONENTS Interpreter Development.Module)
    if(Python_FOUND)
      set(BT_PYTHON_MODULE ON)
    else()
      message(STATUS "Python module: off, Python's headers not found (BT_PYTHON=AUTO)")
    endif()
  endif()
elseif(NOT BT_PYTHON STREQUAL "OFF")
  message(FATAL_ERROR "BT_PYTHON must be ON, OFF or AUTO, not '${BT_PYTHON}'")
endif()
if(BT_PYTHON_MODULE)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()
