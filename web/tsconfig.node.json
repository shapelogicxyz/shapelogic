{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/engine/**/*.ts",
    "tools/**/*.ts",
    "fake-engine/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["tests/e2e/**"]
}
