{
  "name": "shapelogic",
  "version": "1.0.0",
  "private": true,
  "description": "The web front end of ShapeLogic: Electron + TypeScript over shapelogic_engine (docs/FRONTEND-PLAN.md)",
  "homepage": "https://shapelogic.xyz",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "node tools/gen-api.ts",
    "record": "node tools/record-sessions.ts",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.e2e.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && node tools/dist.ts",
    "docs-shots": "electron-vite build && playwright test -c playwright.docs.config.ts",
    "demo": "node tools/build-demo.ts"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.9.9",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
