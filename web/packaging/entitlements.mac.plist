<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's V8 needs JIT under the hardened runtime, and nothing else:
         electron-builder's default adds unsigned executable memory and
         disabled library validation, which this app has not been shown to need -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
