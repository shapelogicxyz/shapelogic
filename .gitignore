*.pyc

# The GUI's crash save, written to the folder it was started from (src/gui/main.cpp)
__rescue.xmpuzzle

# Local generated test output (anchored: tests/data/puzzles/ holds tracked fixtures)
*.stl
/puzzles/
/tictest/
tmp/

# Benchmark and profiling outputs
bench/*.csv
bench_run.log
callgrind*.out*
perf.data*

