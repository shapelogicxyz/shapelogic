{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "CMAKE_OSX_DEPLOYMENT_TARGET: the lowest macOS that the app's Electron (web/package.json) runs on; Electron 44 needs macOS 13. Every macOS build has it, so a library call newer than that fails to compile in the dev build already. The release workflow checks the engine's and the CLI's minos against it. Other systems ignore it.",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0" }
    },
    {
      "name": "dev",
      "displayName": "Debug, warnings as errors",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SL_WERROR": "ON" }
    },
    {
      "name": "release",
      "displayName": "Optimized (assertions stay on)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SL_WERROR": "ON" }
    },
    {
      "name": "release-x64",
      "displayName": "Optimized, for Intel Macs (macOS only; the packaged app's engine, web/tools/dist.ts)",
      "inherits": "release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    },
    {
      "name": "release-arm64",
      "displayName": "Optimized, for Apple silicon Macs (macOS only; the packaged app's engine, web/tools/dist.ts)",
      "inherits": "release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SL_SANITIZE": "address,undefined", "SL_TEST_TIMEOUT_SCALE": "6" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SL_SANITIZE": "thread", "SL_TEST_TIMEOUT_SCALE": "6" }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly: the engine for the website's demo (Emscripten: configure with `emcmake cmake --preset wasm`; just site-demo)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SL_WERROR": "OFF",
        "SL_BUILD_TESTS": "OFF",
        "SL_PYTHON": "OFF",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-fwasm-exceptions"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "release-x64", "configurePreset": "release-x64" },
    { "name": "release-arm64", "configurePreset": "release-arm64" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
